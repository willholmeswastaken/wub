{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "endOfLine": "lf",
  "sortImports": {
    "internalPattern": ["@/**"],
    "newlinesBetween": true
  },
  "sortTailwindcss": {
    "config": "./tailwind.config.ts",
    "functions": ["cn", "clsx", "cva"]
  },
  "ignorePatterns": [".next/**", "node_modules/**", "coverage/**", "bun.lockb"]
}
